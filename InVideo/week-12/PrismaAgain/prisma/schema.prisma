generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id Int @id @default(autoincrement()) //Equal to " id (SERIEL = @default(autoincrement())) (PRIMARY KEY = @id) "
  username String @unique // This means should be Unique
  password String
  firstname String? // (?) this means can be optional
  lastname String?  // (?) this means can be optional
  todos Todos[]
}

model Todos {
  id Int @id @default(autoincrement())
  title String
  description String
  done Boolean @default(false)
  userId Int
  user User @relation(fields: [userId],references: [id])
}

// this has no foreign key contraint
// envery time whenever you change this you have to run the migrate command after all changes done here.
